# Serveur
PORT=5000
NODE_ENV=development

# Base de données (Railway génère DATABASE_URL automatiquement en production)
DATABASE_URL=postgresql://user:password@localhost:5432/renteasy

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000,https://renteasy-frontend.vercel.app,https://renteasy.bj

# URL publique du frontend (utilisée dans les emails d'activation de compte
# et de réinitialisation de mot de passe). À définir en production, sinon
# ces emails pointent vers localhost.
FRONTEND_URL=http://localhost:3000

# Mobile Money - MTN MoMo (Collection)
# Ces variables ne servent que de repli : la configuration réelle se fait
# via Super Admin > Paramètres (table parametres_plateforme).
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com

# Mobile Money - MTN MoMo (Disbursement, requiert une habilitation séparée
# auprès de MTN pour les retraits de solde)
MTN_MOMO_DISBURSEMENT_API_USER=
MTN_MOMO_DISBURSEMENT_API_KEY=
MTN_MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=

# Mobile Money - Moov Money (repli, config réelle via Super Admin > Paramètres)
MOOV_API_KEY=
MOOV_API_SECRET=
MOOV_BASE_URL=

# Mobile Money - Celtiis Pay (repli, config réelle via Super Admin > Paramètres)
CELTIIS_API_KEY=
CELTIIS_API_SECRET=
CELTIIS_BASE_URL=

# SMS (repli, config réelle via Super Admin > Paramètres)
SMS_API_KEY=
SMS_USERNAME=
SMS_EXPEDITEUR=

# Email (Brevo - comme OJADA BANK)
BREVO_API_KEY=
EMAIL_FROM=noreply@renteasy.bj

# Boîte de réception des messages du formulaire de contact public (repli sur EMAIL_FROM)
SUPPORT_EMAIL=support@renteasy.bj
